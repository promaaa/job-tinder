# Racine des données (JSON). Laisser vide pour utiliser le repo courant.
# JOB_TINDER_ROOT=/path/vers/mon/sandbox

# Port API FastAPI/uvicorn
# PORT=8000

# DSN Postgres (ex: postgres://user:pass@localhost:5432/job_tinder)
# PG_DSN=postgres://user:pass@localhost:5432/job_tinder
# DATABASE_URL=postgres://user:pass@localhost:5432/job_tinder

# Sélection du store (json | pg). Par défaut: json
# STORE=pg

# --- Configuration Email (SMTP) ---
# Pour Gmail, utilisez un "App Password" (voir compte Google > Sécurité)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre.email@gmail.com
# SMTP_PASSWORD=votre_app_password
# SMTP_USE_TLS=true

